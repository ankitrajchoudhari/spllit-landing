// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User model with authentication and profile data
model User {
  id                String    @id @default(cuid()) @map("_id")
  name              String
  email             String    @unique
  phone             String?   // Phone number for display
  dateOfBirth       DateTime?
  phoneHash         String    @unique // Hashed phone number for privacy
  phoneVerified     Boolean   @default(false)
  emailVerified     Boolean   @default(false)
  /// Optional: users who onboard through Firebase (Google / Phone OTP) never
  /// set a password. Legacy email+password accounts still have one.
  password          String?
  /// Firebase Auth uid — the join key between the identity provider and this
  /// record. Set on first sign-in, immutable afterwards.
  ///
  /// NOT marked @unique: MongoDB treats every null in a plain unique index as
  /// the same value, so a second user who has never signed in through Firebase
  /// would collide with the first. Uniqueness is enforced by a *sparse* unique
  /// index created in prisma/indexes.mjs, which skips nulls entirely.
  firebaseUid       String?
  /// Handle chosen during onboarding. Lowercase, used in @mentions.
  /// Same story as firebaseUid — sparse unique index, not @unique.
  username          String?
  bio               String?
  college           String
  /// Stable id from content/institutes.ts. `college` stays the display name so
  /// legacy rows keep working; this is what verification is checked against.
  instituteId       String?
  /// The institute address that proved membership (e.g. …@iitm.ac.in). Stored
  /// separately from `email` because sign-in may use a personal Google account.
  instituteEmail    String?
  /// True only once instituteEmail has been confirmed to match instituteId's
  /// domain list. Gates creating and joining rides.
  instituteVerified Boolean   @default(false)
  gender            String    // male/female/other
  profilePhoto      String?
  /// Per-service state so Phase 2/3 services can be added without a new user
  /// system: { rides: {...}, squads: {...}, rentals: {...} }.
  services          Json?
  /// Web-push + mobile FCM registration tokens, deduplicated on write.
  fcmTokens         String[]
  /// Coarse home location for "nearby" queries when live GPS is unavailable.
  homeLat           Float?
  homeLng           Float?
  homeCity          String?
  /// Onboarding completion gate — false until username + college are set.
  onboarded         Boolean   @default(false)
  /// Referral attribution. Holds the *referrer's user id*, resolved from the
  /// `?ref=<username>` on their invite link at signup.
  ///
  /// Set once, on create, and never afterwards: a person is brought in by one
  /// link, and letting it be rewritten later would make any reward payable
  /// twice. Self-referral is rejected at write time.
  referredBy        String?
  referredAt        DateTime?
  /// When the welcome email was sent, and the proof it was sent exactly once.
  ///
  /// Not derivable from anything else: EmailSendLog is swept after two hours
  /// because it exists for rate limiting, and Resend's idempotency key only
  /// covers 24h. Neither can answer "has this person ever been welcomed" a
  /// month later, which is precisely the question the retry path asks.
  welcomedAt        DateTime?
  rating            Float     @default(0)
  totalRides        Int       @default(0)
  role              String    @default("user") // user, admin, subadmin
  isAdmin           Boolean   @default(false)
  adminStatus       String    @default("active") // active, inactive, deleted
  /// Fine-grained console role: super_admin | admin | moderator | support
  /// | analyst. Added for admin.spllit.app.
  ///
  /// Deliberately a *separate* field rather than new values in `role` above.
  /// `role` is read all over the user-facing app and the legacy admin routes,
  /// and widening its vocabulary would change what those reads mean. Null here
  /// means "not set", and the console falls back to deriving a console role
  /// from the legacy fields — so every admin who works today keeps working
  /// without a migration having to run first.
  adminRole         String?
  /// Console permissions granted on top of whatever `adminRole` carries.
  ///
  /// Stored as *overrides* rather than as an absolute list, so a role that is
  /// later tightened or widened still applies to everyone holding it except
  /// where somebody recorded a deliberate exception. An absolute snapshot would
  /// freeze each admin at whatever the role meant the day it was assigned —
  /// and a security-motivated narrowing of a role would then silently not
  /// reach the people already holding it.
  adminGrants       String[]
  /// Permissions taken away, applied *after* grants so a revoke always wins.
  /// This is what a disabled toggle writes.
  adminRevokes      String[]
  /// Every credential issued before this instant is refused.
  ///
  /// Firebase's own `revokeRefreshTokens` stops new ID tokens being minted but
  /// does nothing about one already in a browser, because `verifyIdToken` is
  /// called without `checkRevoked` — that flag costs a network round trip per
  /// request, which is not a trade worth making on every app request to solve
  /// a console problem. Comparing the token's `auth_time` against this column
  /// costs nothing: `identify` already loads this row.
  ///
  /// Both are used together. This kills the token in hand; Firebase's call
  /// stops the client quietly refreshing a new one.
  sessionsRevokedAt DateTime?
  createdBy         String?   // ID of master admin who created this subadmin
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSeen          DateTime  @default(now())
  isActive          Boolean   @default(true)
  
  // Relations
  ridesCreated      Ride[]    @relation("RideCreator")
  matchesAsUser1    Match[]   @relation("MatchUser1")
  matchesAsUser2    Match[]   @relation("MatchUser2")
  messages          Message[]
  locations         Location[]
  blockedUsers      Block[]   @relation("BlockedBy")
  blockingUsers     Block[]   @relation("Blocking")
  emergencies       Emergency[]
  hostProfile       HostProfile?
  
  @@index([college])
  @@index([role])
  @@index([adminStatus])
  @@index([firebaseUid])
  @@index([username])
  @@index([referredBy])
  /// Admin console. The dashboard counts signups in 24h/7d/30d windows and the
  /// signup chart scans a 30-day range; the Users table also sorts on this by
  /// default. Without it each of those is a full collection scan, and there are
  /// four of them on one dashboard load.
  @@index([createdAt])
  /// Admin console. "Seen today" counts `lastSeen >= 24h ago` on every
  /// dashboard load. Same reasoning as createdAt — a range predicate on an
  /// unindexed field scans everything.
  @@index([lastSeen])
}

// Ride model for ride creation and searching
model Ride {
  id              String    @id @default(cuid()) @map("_id")
  userId          String
  origin          String    // Starting location name
  originLat       Float?
  originLng       Float?
  destination     String    // Destination location name
  destLat         Float
  destLng         Float
  departureTime   DateTime
  vehicleType     String    // cab/bike/auto
  seats           Int       @default(1)
  fare            Float?
  genderPref      String    @default("any") // male/female/any
  /// Ride state machine. Transitions are validated server-side only:
  /// requested -> accepted -> arriving -> in_progress -> completed
  ///           \-> cancelled (from requested | accepted | arriving)
  /// Legacy values pending/matched map to requested/accepted respectively.
  status          String    @default("requested")
  /// Intermediate stops between origin and destination, in order.
  stops           GeoPoint[]
  /// Timestamps for each terminal transition, written by the transition handler.
  acceptedAt      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  creator         User      @relation("RideCreator", fields: [userId], references: [id])
  matches         Match[]
  
  @@index([userId])
  @@index([destination])
  @@index([departureTime])
  @@index([status])
  @@index([createdAt])
  /// Admin console. The Rides table filters on status and sorts by createdAt in
  /// the same query. The two single-field indexes above cannot both be used, so
  /// Mongo picks one and sorts the rest in memory — which fails outright once
  /// the intermediate set passes the 32MB sort limit.
  @@index([status, createdAt])
}

/// A rider's published intent: "I want to get from A to B around T".
///
/// Search alone is invisible to hosts — it happens on the rider's screen and
/// leaves nothing behind. This is the opt-in that makes a rider findable, and
/// it is what a host's corridor query actually matches against.
model TripRequest {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  originLabel String
  originLat   Float
  originLng   Float
  destLabel   String
  destLat     Float
  destLng     Float
  departAt    DateTime
  /// Half-width of the acceptable departure window, in minutes.
  windowMins  Int      @default(90)
  seats       Int      @default(1)
  /// open | matched | cancelled | expired
  status      String   @default("open")
  /// Requests go stale: a trip nobody filled yesterday must not surface in a
  /// host's list today. Swept on read rather than by a cron.
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([status, departAt])
}

/// A user's driver side.
///
/// Deliberately a profile hanging off the same User rather than a second
/// account. One person driving on Monday and riding on Tuesday is the normal
/// case, and forking them into two logins would split their rating, their
/// chat history and — once payments land — their money, while giving an
/// abusive host a trivial way to abandon a bad record. Switching to host mode
/// is a view change; becoming a host is this row plus a verified vehicle.
model HostProfile {
  id              String    @id @default(cuid()) @map("_id")
  userId          String    @unique
  /// E.164. Re-collected during host onboarding rather than reused from the
  /// rider profile: a Google sign-in may never have provided one, and a
  /// passenger getting into a stranger's car is owed a reachable number.
  phone           String
  phoneVerified   Boolean   @default(false)
  /// Free text, shown to guests before they commit to a ride.
  about           String?
  /// pending | active | suspended. Set to active only once a vehicle is
  /// verified; the ride-creation gate reads this, never the client.
  status          String    @default("pending")
  suspendedReason String?
  /// Denormalised from Ride so the host dashboard needs one read, not a scan.
  ridesHosted     Int       @default(0)
  rating          Float     @default(0)
  ratingCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  vehicles        Vehicle[]

  @@index([status])
}

/// A vehicle a host offers seats in.
model Vehicle {
  id             String   @id @default(cuid()) @map("_id")
  hostProfileId  String
  /// cab | bike | auto — matches Ride.vehicleType so a ride can only be
  /// created for a class the host actually owns a verified vehicle in.
  type           String
  /// Ids from content/vehicles.ts, not free text, so "Maruti" and "Maruti
  /// Suzuki" cannot become two brands.
  brandId        String
  modelId        String
  /// Display strings captured at registration. Kept alongside the ids so a
  /// later catalogue edit cannot silently rewrite what a guest was shown.
  brandLabel     String
  modelLabel     String
  colour         String?
  /// Normalised registration mark: uppercase, no spaces or hyphens.
  /// Unique via a partial index in prisma/indexes.mjs — one plate, one host.
  plate          String
  /// Seats offered to guests, excluding the driver.
  seats          Int      @default(3)
  /// pending | verified | rejected
  status         String   @default("pending")
  rejectionNote  String?
  verifiedAt     DateTime?
  /// The host's default vehicle. Exactly one per host is true; enforced in the
  /// route handler, which clears the flag on the others in the same write.
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hostProfile    HostProfile @relation(fields: [hostProfileId], references: [id], onDelete: Cascade)

  @@index([hostProfileId])
  @@index([status])
  @@index([plate])
}

// Persistent ride announcements for the dashboard bell feed
model RideAnnouncement {
  id              String    @id @default(cuid()) @map("_id")
  rideId          String    @unique
  title           String
  message         String
  origin          String
  destination     String
  creatorName     String
  creatorCollege  String?
  departureTime   DateTime
  fare            Float?
  vehicleType     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([departureTime])
}

// Admin-posted announcements for the home dashboard feed
model Announcement {
  id              String    @id @default(cuid()) @map("_id")
  title           String
  message         String
  location        String
  imageUrl        String?
  imageAlt        String?
  createdById     String
  createdByName   String
  createdByRole   String    @default("admin")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([createdByRole])
}

// Match model for connecting users
model Match {
  id              String    @id @default(cuid()) @map("_id")
  rideId          String
  user1Id         String    // Ride creator
  user2Id         String    // Matched user
  chatRoomId      String    @unique
  status          String    @default("pending") // pending/accepted/rejected/completed/cancelled
  /// host | guest — who made the opening move.
  ///
  /// A host inviting a rider and a rider asking to join are the same edge with
  /// the same states; only the direction differs, and whose turn it is to
  /// respond follows from it. Modelling invites separately would have meant a
  /// second place that counts seats.
  initiatedBy     String    @default("guest")
  /// The TripRequest a host invited, when the invite came from one.
  requestId       String?
  matchedAt       DateTime  @default(now())
  acceptedAt      DateTime?
  declinedAt      DateTime?
  completedAt     DateTime?
  
  // Relations
  ride            Ride      @relation(fields: [rideId], references: [id])
  user1           User      @relation("MatchUser1", fields: [user1Id], references: [id])
  user2           User      @relation("MatchUser2", fields: [user2Id], references: [id])
  messages        Message[]
  
  @@unique([rideId, user1Id, user2Id])
  @@index([status])
  @@index([user2Id, status])
  @@index([requestId])
}

// Message model for chat
model Message {
  id              String    @id @default(cuid()) @map("_id")
  matchId         String
  senderId        String
  content         String
  type            String    @default("text") // text/location/image
  metadata        Json?     // For location coords, image URLs, etc.
  read            Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  editedAt        DateTime?
  createdAt       DateTime  @default(now())
  
  // Relations
  match           Match     @relation(fields: [matchId], references: [id])
  sender          User      @relation(fields: [senderId], references: [id])
  
  @@index([matchId])
  @@index([senderId])
  @@index([createdAt])
}

// Location model for live tracking
model Location {
  id              String    @id @default(cuid()) @map("_id")
  userId          String
  latitude        Float
  longitude       Float
  accuracy        Float?
  heading         Float?    // Direction of travel
  speed           Float?    // Speed in m/s
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([createdAt])
  @@index([isActive])
}

// Block model for user safety
model Block {
  id              String    @id @default(cuid()) @map("_id")
  blockerId       String
  blockedId       String
  reason          String?
  createdAt       DateTime  @default(now())
  
  // Relations
  blocker         User      @relation("BlockedBy", fields: [blockerId], references: [id])
  blocked         User      @relation("Blocking", fields: [blockedId], references: [id])
  
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Admin model for platform management
model Admin {
  id              String    @id @default(cuid()) @map("_id")
  email           String    @unique
  password        String    // Hashed password
  name            String
  role            String    @default("admin") // admin/master
  isActive        Boolean   @default(true)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?   // ID of master admin who created this admin
  
  @@index([role])
}

// Emergency model for SOS alerts
model Emergency {
  id              String    @id @default(cuid()) @map("_id")
  userId          String
  locationLat     Float
  locationLng     Float
  message         String
  emergencyType   String    @default("other") // accident/harassment/medical/other
  status          String    @default("active") // active/acknowledged/resolved/false-alarm
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Early access registrations for Spllit Social launch
model EarlyAccess {
  id              String    @id @default(cuid()) @map("_id")
  name            String
  email           String    @unique
  phone           String
  message         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
}

// Mail provider configuration for automation
model MailProvider {
  id              String    @id @default(cuid()) @map("_id")
  name            String    // gmail/zoho
  recipientEmail  String    @unique // team@spllit or any email
  refreshToken    String    // For Gmail OAuth
  apiKey          String?   // For Zoho
  password        String?   // For Zoho SMTP
  smtp            String    // e.g., smtp.zoho.com
  port            Int       @default(587)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
}

// Automation mail campaign logs
model AutomationMail {
  id              String    @id @default(cuid()) @map("_id")
  adminId         String    // Admin who created this
  providerName    String    // mail provider used
  subject         String
  prompt          String    // Original AI prompt
  generatedMessage String   // AI-generated message
  recipientCount  Int
  successCount    Int       @default(0)
  failureCount    Int       @default(0)
  status          String    @default("pending") // pending/processing/completed/failed
  errorLog        String?   // Error details if failed
  csvFilePath     String?   // Path to uploaded CSV
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PHASE 1 PLATFORM MODELS — Squads, Events, Communities, Notifications
//
// These replace the Firestore collections in the original spec. Live/ephemeral
// data (positions, presence, typing) is NOT stored here — it travels over
// Socket.IO rooms and is only persisted when it becomes durable state.
// ---------------------------------------------------------------------------

/// Embedded geo point. Used for meeting points, venues and pickup/drop stops.
type GeoPoint {
  lat     Float
  lng     Float
  /// Human-readable label resolved via Mapbox geocoding at write time, so we
  /// never re-geocode on read.
  label   String?
  address String?

  /// WHAT this coordinate is, in the provider's own vocabulary — `poi`,
  /// `address`, `street`, `locality`, `place` and so on, or `pickup_point` for a
  /// Spllit-verified point. Null when nothing named it: a pin dropped on a blank
  /// stretch of map has no feature type.
  ///
  /// The provider's string, deliberately, and never the integer that
  /// `featurePrecision()` derives from it. That integer is a ranking judgement
  /// defined by a table we own and tune; stored rows would silently change
  /// meaning the next time it is reordered, with no migration to catch it.
  featureType        String?

  /// Metres from this coordinate to the nearest road a car can use, as measured
  /// when the point was saved.
  ///
  /// Null means *not confirmed*, and covers every way that can happen — never
  /// asked, lookup failed, nothing found, or a road too far to be worth
  /// reporting. There is deliberately no stored value for "no road": that is a
  /// negative claim about a 400 m radius and one tileset version, and it ages
  /// badly in a way a number does not.
  roadDistanceMetres Float?

  /// HOW this coordinate was chosen.
  ///   search     — the user picked a provider search result
  ///   manual     — the user pointed at it, or moved a pin onto it
  ///   device     — it came from the device's own position
  ///   suggestion — the system proposed a roadside point and the user accepted it
  ///
  /// Not `roadside`: whether a point is beside a road is a fact about the
  /// coordinate, held above in `roadDistanceMetres`, and a tapped pin eight
  /// metres from a kerb is just as roadside without anything having suggested it.
  source             String?

  /// GPS accuracy in metres. Set only for `device` points, because only a
  /// measurement has measurement error — a pin somebody pointed at has none, and
  /// writing a figure for it would be inventing a precision claim.
  accuracyMetres     Float?
}

/// A Squad is a persistent group that moves together — the Phase 1 headline
/// feature alongside Ride Together.
model Squad {
  id            String    @id @default(cuid()) @map("_id")
  name          String
  description   String?
  /// Squad avatar / cover image.
  imageUrl      String?
  /// Owning user id. Only the leader may edit the meeting point (enforced in
  /// middleware, never in the client).
  leaderId      String
  college       String?
  /// study | travel | event | office | hostel | sports | general.
  /// Drives the default theme and which sections the squad home shows.
  type          String    @default("general")
  /// public = discoverable | private = code or link | invite = leader adds only.
  visibility    String    @default("public")
  /// Short shareable code. Uppercase, ambiguity-free alphabet (no O/0/I/1).
  /// Sparse-unique via prisma/indexes.mjs — nulls must not collide.
  joinCode      String?
  /// active | in_progress | completed | cancelled. Terminal states stop
  /// location sharing.
  ///
  /// `active` is the pre-start state and is labelled "Scheduled" in the UI;
  /// the stored value keeps its original name so no migration has to rewrite
  /// every existing row or every query that filters on it. `in_progress` means
  /// the scheduled time has passed and people may still be travelling — it is
  /// not a lesser form of active, and joining, chat and navigation all continue.
  ///
  /// Derived on read rather than by a scheduled job; see services/squadLifecycle.ts.
  status        String    @default("active")
  /// Hard cap including the leader. Null means no cap.
  memberLimit   Int?
  /// Accent for markers and the squad header.
  themeColor    String?
  /// Where the squad is going *after* meeting, when that differs.
  destination   GeoPoint?
  /// Where the squad is meeting. Nullable until the leader sets it.
  meetingPoint  GeoPoint?
  meetingAt     DateTime?
  /// How long the squad is expected to last, from `meetingAt`. Null means the
  /// leader did not say, and the lifecycle assumes its default.
  durationMinutes Int?
  /// Last *meaningful* activity: a message, a membership change, a position
  /// report, an arrival, or the meeting details being edited.
  ///
  /// Explicitly not bumped by reading the squad. Reads are what trigger
  /// lifecycle evaluation, so if reading counted as activity then any squad
  /// somebody glanced at would postpone its own expiry indefinitely.
  lastActivityAt DateTime?
  /// When the squad reached a terminal state, however it got there.
  ///
  /// Null while live. Set once, on the transition into completed/cancelled —
  /// never recomputed, because the chat retention windows are measured from it
  /// and a value that moved would silently extend or shorten them.
  ///
  /// `updatedAt` cannot serve this: any later write bumps it, so a squad
  /// touched by a cleanup job would look like it had just ended.
  ///
  /// Nullable and additive, so on MongoDB existing squads simply read null.
  /// A squad that ended before this field existed has no anchor and is treated
  /// as still-readable rather than retroactively erased — see
  /// services/squadChatRetention.ts.
  endedAt       DateTime?
  /// Denormalised counter so map markers and list cards do not need a join.
  memberCount   Int       @default(0)
  /// Centre of the squad, used for map clustering and "nearby" queries.
  lat           Float?
  lng           Float?
  /// Derived from `status` on every write — never set independently. It exists
  /// because @@index([visibility, isActive]) drives discovery; the definition
  /// lives in squadLifecycle.isLiveStatus so the two cannot drift.
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members       SquadMember[]

  @@index([leaderId])
  @@index([college])
  @@index([visibility, isActive])
  @@index([status])
  @@index([createdAt])
}

/// A join fee paid by a member to unlock a squad's chat, calling and navigation.
///
/// Its own model rather than a flag on SquadMember because money needs a record
/// that survives the thing it paid for: a member can leave, a squad can be
/// cancelled, and the payment still has to be reconcilable against Razorpay's
/// own ledger during a dispute.
model SquadPayment {
  id            String    @id @default(cuid()) @map("_id")
  squadId       String
  userId        String
  /// Paise, not rupees — never store money as a float.
  amountPaise   Int       @default(200)
  currency      String    @default("INR")
  /// created | paid | failed | refunded
  ///
  /// `created` means an order exists at Razorpay but no money has moved. Access
  /// is granted on `paid` and nothing else.
  status        String    @default("created")
  /// Razorpay's order id, returned when the order is created.
  razorpayOrderId   String?
  /// Set once the signature has been verified server-side.
  razorpayPaymentId String?
  /// The verified signature, kept for dispute evidence.
  razorpaySignature String?
  failureReason String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  /// One live payment attempt per member per squad. Retrying a failed attempt
  /// reuses the row rather than accumulating orphans.
  @@unique([squadId, userId])
  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

model SquadMember {
  id        String   @id @default(cuid()) @map("_id")
  squadId   String
  userId    String
  /// leader | co-leader | member | guest.
  /// Capability is derived from this in one place (squadPermissions) rather
  /// than re-checked per route, so a new capability cannot be added to one
  /// handler and forgotten in another.
  role      String   @default("member")
  /// True once the join fee is paid. Chat, calling and navigation check this.
  ///
  /// Denormalised from SquadPayment deliberately: it is read on every message
  /// and every position report, and a join across collections on that path is
  /// not worth the normalisation.
  feePaid   Boolean  @default(false)
  /// pending | active | travelling | arrived | left
  ///
  /// `pending` is a join request awaiting the leader. `travelling` and
  /// `arrived` are journey states the member drives; they never mean access.
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  /// Last self-reported position. Coarse and short-lived by design — this is
  /// "am I close yet", not a location history, and it is cleared on leave.
  lat       Float?
  lng       Float?
  locationAt DateTime?
  /// Reported alongside position so a leader can tell "stopped moving" from
  /// "phone died". Optional — a browser may expose neither.
  battery   Int?
  network   String?
  /// Set once by arrival detection; distinguishes "arrived" from "was near".
  arrivedAt DateTime?
  /// Last computed ETA to the meeting point, in seconds. Written by the server
  /// after a Directions call, cached briefly — never computed on the client.
  etaSeconds Int?
  etaUpdatedAt DateTime?

  squad     Squad    @relation(fields: [squadId], references: [id])

  @@unique([squadId, userId])
  @@index([userId])
  @@index([squadId, status])
  @@index([squadId, role])
}

model Event {
  id             String    @id @default(cuid()) @map("_id")
  title          String
  description    String?
  imageUrl       String?
  hostId         String
  college        String?
  /// Venue location. Required — an event without a place cannot render on the map.
  venue          GeoPoint
  startsAt       DateTime
  endsAt         DateTime?
  /// free | paid
  ticketType     String    @default("free")
  price          Float?
  capacity       Int?
  attendeeCount  Int       @default(0)
  category       String?
  /// draft | published | cancelled | completed
  status         String    @default("published")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attendees      EventAttendee[]

  @@index([hostId])
  @@index([startsAt])
  @@index([college])
  @@index([status, startsAt])
}

model EventAttendee {
  id        String   @id @default(cuid()) @map("_id")
  eventId   String
  userId    String
  /// going | interested | cancelled
  status    String   @default("going")
  joinedAt  DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
}

model Community {
  id            String    @id @default(cuid()) @map("_id")
  name          String
  slug          String    @unique
  description   String?
  imageUrl      String?
  bannerUrl     String?
  college       String?
  /// public | college-only | private
  visibility    String    @default("public")
  memberCount   Int       @default(0)
  ownerId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  channels      Channel[]
  members       CommunityMember[]

  @@index([college])
  @@index([visibility])
  /// Admin console. Default sort for the Communities table.
  @@index([createdAt])
}

model CommunityMember {
  id           String    @id @default(cuid()) @map("_id")
  communityId  String
  userId       String
  /// owner | moderator | member
  role         String    @default("member")
  joinedAt     DateTime  @default(now())

  community    Community @relation(fields: [communityId], references: [id])

  @@unique([communityId, userId])
  @@index([userId])
}

model Channel {
  id           String    @id @default(cuid()) @map("_id")
  communityId  String
  name         String
  /// Stable key so the client can deep-link: general | placements | internships
  /// | events | marketplace, plus custom channels.
  slug         String
  description  String?
  position     Int       @default(0)
  isReadOnly   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  community    Community @relation(fields: [communityId], references: [id])

  @@unique([communityId, slug])
  @@index([communityId, position])
}

/// One conversation, whatever it is attached to. Squad chat, ride chat, a
/// community channel and a 1:1 DM are all rows in this table — which is what
/// lets a single ChatThread component on the client serve all four.
model ChatThread {
  id             String   @id @default(cuid()) @map("_id")
  /// squad | ride | channel | dm
  contextType    String
  /// squadId | rideId | channelId | sorted "uidA:uidB" for DMs
  contextId      String
  title          String
  imageUrl       String?
  /// Denormalised so listing a user's threads is one query, not a join per row.
  participantIds String[]
  lastMessageAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       ThreadMessage[]

  @@unique([contextType, contextId])
  @@index([participantIds])
  @@index([updatedAt])
}

/// Message history lives in Mongo (not the ephemeral layer) so it is durable
/// and paginable. Typing indicators and presence stay on Socket.IO.
model ThreadMessage {
  id         String   @id @default(cuid()) @map("_id")
  threadId   String
  senderId   String
  content    String
  /// text | image | file | location | live-location | meeting-point | ride-invite
  type       String   @default("text")
  metadata   Json?
  replyToId  String?
  isDeleted  Boolean  @default(false)
  editedAt   DateTime?
  createdAt  DateTime @default(now())

  thread     ChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@index([senderId])
  /// Admin console. "Messages in the last 24h" on the dashboard counts across
  /// every thread; the compound index above leads with threadId and so cannot
  /// serve it. This is the highest-volume collection in Spllit, which makes it
  /// the one where a scan hurts soonest.
  @@index([createdAt])
}

/// One announcement, and what happened to it.
///
/// Kept because a broadcast is the one email nobody can take back: it exists so
/// that "what did we send, to how many, and who pressed send" has an answer six
/// months later, when somebody asks why they got it.
model Campaign {
  id          String    @id @default(cuid()) @map("_id")
  subject     String
  body        String
  /// Admin user id. Not a relation — the record must survive the account.
  createdBy   String
  createdName String?
  /// draft | sending | sent | failed
  status      String    @default("draft")
  /// How many the audience query matched when sending began.
  audience    Int       @default(0)
  /// Who it was aimed at. All three are additive and nullable, so existing rows
  /// read as the old behaviour — `all` — without a migration.
  ///
  /// Stored on the row rather than resolved at send time because a campaign is
  /// a record of what was sent to whom. Recomputing "everyone onboarded" months
  /// later would answer with today's population, not the one that received it.
  /// all | active | inactive | onboarding | college | users
  audienceKind    String?
  audienceCollege String?
  audienceUserIds String[]
  /// Accepted by the provider. Delivery is a separate question, answered by
  /// webhooks rather than by this number.
  sent        Int       @default(0)
  /// Refused before sending: suppressed, unverified, or opted out.
  skipped     Int       @default(0)
  failed      Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Addresses Spllit must never email again.
///
/// Fed by Resend's delivery webhooks. A hard bounce means the address does not
/// exist; a complaint means somebody pressed "this is spam". Continuing to send
/// to either is the single fastest way to have a sending domain blocked, and
/// both are permanent decisions made by the receiving side rather than by us.
///
/// Keyed on the address, not the user: the same address may be reused by a
/// different account, and the mailbox is what bounced.
model EmailSuppression {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  /// bounce | complaint | unsubscribe | manual
  reason    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([reason])
}

/// What a person wants to be emailed about.
///
/// Absent means "everything on" — a row is written only when somebody changes
/// something, so the default costs no storage and no migration.
model NotificationPref {
  id         String   @id @default(cuid()) @map("_id")
  userId     String   @unique
  /// Category keys switched OFF. A list rather than a column per type, so
  /// adding a category is not a schema change and an unknown key from an older
  /// client is simply ignored.
  emailOff   String[]
  /// Whether to hold non-urgent mail overnight.
  quietHours Boolean  @default(true)
  /// IANA zone, e.g. Asia/Kolkata. Null falls back to the app's default.
  timezone   String?
  updatedAt  DateTime @updatedAt
}

/// One row per message actually sent.
///
/// Exists for rate limiting rather than for analytics, which is why it holds no
/// content: the cool-off that stops five join requests becoming five emails
/// needs to know when this recipient was last mailed about this squad, and the
/// per-recipient hourly cap needs a count. Swept with the other retention jobs.
model EmailSendLog {
  id       String   @id @default(cuid()) @map("_id")
  userId   String
  /// Category key, e.g. join-request.
  category String
  /// What the message was about — a squad id — so the cool-off is per squad
  /// rather than silencing every squad because one was busy.
  scopeId  String?
  sentAt   DateTime @default(now())

  @@index([userId, sentAt])
  @@index([userId, category, scopeId, sentAt])
}

/// A single-use link that identifies one pending join request.
///
/// Emailed to a leader so they can answer a request without hunting for the
/// squad. It identifies *which* request; it never authorises anyone — the
/// endpoint still requires a session and still checks that the caller may admit
/// members. See docs/EMAIL-SYSTEM.md.
model JoinRequestToken {
  id         String    @id @default(cuid()) @map("_id")
  /// SHA-256 of the token, never the token. A dump of this collection yields
  /// nothing usable, which a signed token in a URL could not offer — and unlike
  /// a JWT, a row can be revoked.
  tokenHash  String    @unique
  /// Bound at creation, all three checked on use, so a token cannot be replayed
  /// against a different squad or a different request.
  squadId    String
  /// The SquadMember row holding the pending request.
  memberId   String
  /// Who the link was sent to. The session must match this, or hold the same
  /// permission by another route.
  leaderId   String
  expiresAt  DateTime
  /// Set the moment a decision is taken. Single use: a forwarded email is spent
  /// once, and the second reader gets the same neutral "no longer open".
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

/// Per-user read position. Kept separate from the thread so a read receipt
/// write never contends with a message write.
model ThreadReadState {
  id           String   @id @default(cuid()) @map("_id")
  threadId     String
  userId       String
  lastReadAt   DateTime @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

/// In-app notifications. Each `type` maps to a typed renderer on the client —
/// never a generic string blob.
model Notification {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  /// squad.joined | squad.meeting_point_updated | ride.accepted | ride.arriving
  /// | ride.started | ride.completed | friend.nearby | event.created
  /// | event.reminder | community.mention | chat.message
  type       String
  title      String
  body       String
  /// Typed payload for the renderer: { squadId } | { rideId } | { eventId } ...
  data       Json?
  imageUrl   String?
  /// Deep link the notification opens.
  href       String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  /// Admin console. Both existing indexes lead with userId, so neither serves
  /// the console's cross-user queries: the notifications table sorts by
  /// createdAt over everyone, and the dashboard counts the last 24 hours the
  /// same way.
  @@index([createdAt])
  /// Admin console. The notifications table filters by type and sorts by
  /// createdAt together.
  @@index([type, createdAt])
}

/// Waitlist capture for Phase 2 surfaces (Rentals, Bills, Marketplace).
model Waitlist {
  id         String   @id @default(cuid()) @map("_id")
  /// rentals | bills | marketplace
  service    String
  email      String
  userId     String?
  college    String?
  note       String?
  createdAt  DateTime @default(now())

  @@unique([service, email])
  @@index([service])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PHASE 2 STUBS — schema reserved now so adding these later needs no new auth
// or user system. No routes are wired to them yet.
// ---------------------------------------------------------------------------

model RentalListing {
  id          String    @id @default(cuid()) @map("_id")
  ownerId     String
  title       String
  description String?
  /// vehicle | room | equipment | other
  category    String
  images      String[]
  pricePerDay Float
  deposit     Float?
  location    GeoPoint
  /// available | rented | inactive
  status      String    @default("available")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([category, status])
}

model MarketplaceListing {
  id          String    @id @default(cuid()) @map("_id")
  sellerId    String
  title       String
  description String?
  category    String
  images      String[]
  price       Float
  /// new | like-new | used
  condition   String    @default("used")
  location    GeoPoint?
  college     String?
  /// active | sold | withdrawn
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sellerId])
  @@index([category, status])
  @@index([college])
}

/// Bill splitting ledger entry. Phase 2.
model Transaction {
  id          String    @id @default(cuid()) @map("_id")
  /// ride | rental | marketplace | manual
  context     String
  contextId   String?
  payerId     String
  /// { userId, amount, settled } per participant.
  splits      Json
  totalAmount Float
  currency    String    @default("INR")
  note        String?
  /// pending | settled | cancelled
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  settledAt   DateTime?

  @@index([payerId])
  @@index([context, contextId])
  @@index([status])
}

// ===========================================================================
// Admin console (admin.spllit.app)
//
// Everything below is additive. No existing model or field was changed, so the
// user-facing app reads and writes exactly what it did before these were added.
// MongoDB creates a collection on first write, so nothing here needs a
// migration step — `prisma db push` is enough to refresh the client.
// ===========================================================================

/**
 * One row per privileged action taken in the admin console.
 *
 * Append-only by convention: there is no update or delete path in the console,
 * because a log an admin can edit is not evidence of anything. `before`/`after`
 * hold the changed subset of the target, not the whole document — a full copy
 * would silently accumulate personal data in a collection that is kept far
 * longer than the record it describes.
 *
 * Failures are recorded too. A refused attempt to ban a user is exactly the
 * kind of thing worth being able to look up later, and it only exists here if
 * the write happens whether or not the action succeeded.
 */
model AuditLog {
  id           String   @id @default(cuid()) @map("_id")
  /// User.id of the admin who acted. Not a relation: audit rows outlive the
  /// accounts they refer to, and a cascade would delete the evidence along
  /// with the admin.
  actorId      String
  /// Denormalised so the log stays readable after the account is gone.
  actorEmail   String
  actorRole    String
  /// Dotted verb, e.g. user.suspend | flag.update | setting.change
  action       String
  /// user | squad | ride | event | community | flag | setting | admin
  targetType   String
  targetId     String?
  /// Human label for the target at the time of the action.
  targetLabel  String?
  /// Changed fields only, never the whole document.
  before       Json?
  after        Json?
  /// Required by the console for anything destructive.
  reason       String?
  success      Boolean  @default(true)
  /// Populated on failure so a denied action explains itself.
  errorMessage String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([createdAt])
}

/**
 * Runtime feature flags, so turning something off does not need a deploy.
 *
 * `rolloutPercentage` is resolved against a stable hash of the user id rather
 * than a random draw, so a user who is inside a 20% rollout stays inside it on
 * the next request instead of flickering between variants.
 */
model FeatureFlag {
  id                String   @id @default(cuid()) @map("_id")
  /// Stable machine key, e.g. rides.new_map
  key               String   @unique
  label             String
  description       String?
  enabled           Boolean  @default(false)
  /// 0–100. Ignored when `enabled` is false: off means off for everyone.
  rolloutPercentage Int      @default(100)
  /// User.ids always inside the flag regardless of percentage.
  targetUserIds     String[]
  /// Empty means every environment.
  environments      String[]
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([enabled])
}

/**
 * Key/value platform settings edited from the console.
 *
 * `requiresConfirmation` travels with the setting rather than living in the UI,
 * so a dangerous switch cannot become a one-click toggle by being rendered
 * somewhere new.
 */
model PlatformSetting {
  id                   String   @id @default(cuid()) @map("_id")
  /// Dotted key, e.g. moderation.auto_suspend_threshold
  key                  String   @unique
  /// general | auth | users | communities | chat | events | rides | maps
  /// | notifications | moderation | security | api | payments | system
  category             String
  label                String
  description          String?
  /// string | number | boolean | json
  valueType            String   @default("string")
  value                Json
  requiresConfirmation Boolean  @default(false)
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// Realtime metrics (Phase 3)
//
// The dashboard used to answer every counter with a live count() over the
// collection. That is affordable at a 60-second poll and ruinous at three
// seconds: ~20 counters against a growing database, forever, whether or not
// anyone has the tab open. These two models exist so the common case is a
// keyed read and an atomic increment instead.
// ---------------------------------------------------------------------------

/// A running lifetime total, incremented on write rather than recounted.
///
/// Separate from MetricRollup because a lifetime figure must not be computed by
/// summing every daily bucket ever recorded — that cost grows without bound,
/// which is the problem this whole model exists to avoid.
model MetricCounter {
  /// Dotted metric key: user.created | ride.created | message.sent …
  key       String   @id @map("_id")
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// One day's worth of one metric.
///
/// The id is `<metric>:<day>` rather than a cuid, so an increment is a single
/// keyed upsert with no lookup first. Two writes landing in the same
/// millisecond then collide on the primary key instead of silently creating a
/// second bucket for the same day and halving the number the dashboard shows.
model MetricRollup {
  /// "<metric>:<YYYY-MM-DD>"
  id     String @id @map("_id")
  metric String
  /// UTC day. Stated because a rollup keyed on local time double-counts and
  /// skips days whenever the server's zone changes under it.
  day    String
  count  Int    @default(0)

  @@index([metric, day])
  @@index([day])
}

/// The live activity feed.
///
/// Deliberately denormalised and deliberately small: a feed row is a headline
/// plus a link, never a copy of the record. Rows are pruned by
/// `services/adminEvents.ts` rather than kept forever — this is a window onto
/// what is happening now, and an unbounded one would become the largest
/// collection in the database purely to serve a sidebar.
model ActivityEvent {
  id         String   @id @default(cuid()) @map("_id")
  /// Matches the event names in docs/ADMIN-CONSOLE.md, e.g. USER_CREATED.
  type       String
  title      String
  subtitle   String?
  /// user | ride | squad | event | community | emergency | admin
  entityType String?
  entityId   String?
  /// Console-relative deep link, resolved when the row is written.
  href       String?
  /// info | warning | danger — drives the dot colour, nothing else.
  severity   String   @default("info")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Analytics (Phase 4)
// ---------------------------------------------------------------------------

/// One row per user per UTC day they were active.
///
/// `User.lastSeen` cannot answer this. It is written at login and nowhere else,
/// so it records a last *login*, not activity, and it holds a single instant —
/// there is no history in it to compute a retention curve from.
///
/// The id is `<userId>:<day>` rather than a cuid so marking someone active is
/// one keyed upsert with no lookup first, and so two requests in the same
/// millisecond collide on the primary key instead of writing the user twice
/// and inflating every figure derived from this table.
///
/// Deliberately holds no event detail. This answers "was this person here that
/// day", which is all DAU, WAU, MAU and retention need; recording what they did
/// would make it a behavioural log of every user, kept indefinitely, to compute
/// numbers that never look at the contents.
model ActiveUserDay {
  /// "<userId>:<YYYY-MM-DD>"
  id        String   @id @map("_id")
  userId    String
  /// UTC day, matching MetricRollup.
  day       String
  createdAt DateTime @default(now())

  @@index([day])
  @@index([userId, day])
}
