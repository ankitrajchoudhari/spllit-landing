# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=""

# JWT
JWT_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_second_long_random_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Firebase Admin (required for Google login verification)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Testmail (for automated Firebase email verification testing only)
TESTMAIL_API_KEY=your_testmail_api_key
TESTMAIL_NAMESPACE=your_testmail_namespace
# Optional: default tag/mailbox if script is run without --tag
# TESTMAIL_MAILBOX=signup
TESTMAIL_BASE_URL=https://api.testmail.app/api/json
TESTMAIL_TIMEOUT_MS=120000
TESTMAIL_POLL_INTERVAL_MS=5000

# OpenAI API (for mail automation - use GPT-4o Mini for cost optimization)
OPENAI_API_KEY=your_openai_api_key

# --- Sarvam (natural-language understanding) --------------------------------
# Reads what a user types in their own words — Hindi, Tamil, romanised or
# code-mixed with English — and fills in the squad create form for them to
# confirm. Server-side only; it must never reach the browser, and there is no
# NEXT_PUBLIC_ equivalent of this by design.
#
# Without it, /api/ai/status answers false, the "describe your trip" box is not
# rendered at all, and the create form behaves exactly as it did before.
SARVAM_API_KEY=

# Model calls per minute this process will make, across every AI feature.
# Sarvam limits sarvam-105b by ACCOUNT, not per endpoint: 40/min on Starter,
# 60 on Pro, 120 on Business. Keep this comfortably under the plan's ceiling —
# the headroom absorbs SDK retries, which spend from the same allowance.
SARVAM_CALLS_PER_MINUTE=30

# Deprecation usage logging (docs/DEPRECATION-POLICY.md)
# Records every call to a deprecated router so route deletion can be justified
# by runtime evidence instead of repository search. Observational only — it
# never alters a response. Enabled by default; set to false to silence.
DEPRECATION_LOG=true

# Razorpay (squad join fee). Without these, payment endpoints answer 503 and
# the join flow tells the user payments are unavailable rather than failing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
# Separate secret, set in the Razorpay dashboard when you add the webhook.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Scheduled maintenance --------------------------------------------------
# Shared secret for /api/maintenance/*, which Cloud Scheduler calls on a fixed
# cadence — today that is the squad-chat erase, which must happen whether or not
# anyone opens the app.
#
# Optional. Without it those routes answer 404 and do not exist, so leaving it
# unset is safe: the opportunistic sweep still runs, it is simply best-effort.
#
# Generate one that is not memorable, because nothing needs to remember it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAINTENANCE_KEY=

# --- Transactional email (Resend) -------------------------------------------
# Two messages only: a leader is told somebody asked to join, and an asker is
# told they were let in. See docs/EMAIL-SYSTEM.md.
#
# Optional. Without the key nothing sends and nothing throws — an install that
# has not set up a sending domain is quiet, not broken. Mail is never the source
# of truth; the in-app notification is.
RESEND_API_KEY=
EMAIL_FROM=Spllit <notifications@mail.spllit.app>
EMAIL_REPLY_TO=support@spllit.app
# Used to build links inside emails.
APP_URL=https://spllit.app
