# ---------------------------------------------------------------------------
# Spllit admin console — environment
#
# Every value is read through lib/config.ts. Nothing else touches process.env.
#
# Every variable here is NEXT_PUBLIC_ and is therefore compiled into the
# browser bundle. That is deliberate and safe *because none of them is a
# secret*: the Mongo URL, Firebase Admin service account, Mapbox server token
# and Razorpay keys live on the backend and are never sent here.
#
# If you find yourself wanting to add a secret to this file, the operation it
# belongs to belongs on the backend instead.
#
# Copy to .env.local for development.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_ENV=development

# --- API -------------------------------------------------------------------
# The Spllit backend, including the /api suffix — same value the main app uses.
#   local:      http://localhost:3001/api
#   production: https://api.spllit.app/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Same host WITHOUT /api. Socket.IO mounts at the root. Used from Phase 4.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# --- Firebase (identity only) ----------------------------------------------
# MUST be the same Firebase project as the main app. An admin is a Spllit user
# whose row carries a console role, so a different project means the account
# signing in here does not exist in the database the backend checks.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# The WEB app id (contains ":web:"), not Android or iOS.
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Zoho sign-in (optional) -----------------------------------------------
# Spllit's @spllit.app addresses are hosted on Zoho Mail, but Zoho hosts a
# MAILBOX — it is not an identity provider here. Firebase does the
# authenticating either way.
#
# An email+password account for ankit@spllit.app works with no configuration at
# all, and its reset mail lands in the Zoho inbox. That is the recommended path.
#
# A "Continue with Zoho" button needs Zoho registered as a generic OIDC provider
# in Firebase, which requires Identity Platform (a paid upgrade). Once that
# exists, set this to the provider id Firebase assigns — it starts with "oidc.".
#
# Left empty, the button is not rendered. A button that cannot work is worse
# than no button.
NEXT_PUBLIC_ZOHO_PROVIDER_ID=
