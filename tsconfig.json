{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // `tests/` runs under `node --test`, which strips types rather than
    // compiling and therefore needs the real file name in the specifier. Safe
    // with noEmit: nothing here is ever emitted, so the extension cannot end up
    // in output. App code still imports through the `@/*` paths.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backend",
    // The admin console is its own Next.js app with its own tsconfig and its
    // own dependencies. Without this it would be pulled into the main app's
    // typecheck — the one the frontend deploy workflow runs — and fail it on
    // imports that only resolve inside admin/.
    "admin"
  ]
}
